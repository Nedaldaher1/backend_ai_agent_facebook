# Copy to .env and fill in. Validated at boot by src/core/config/env.schema.ts.
NODE_ENV=development
PORT=3000

# CORS — browser origins allowed to call the API, comma-separated.
# Local dev auto-allows any http://localhost:<port> (Vite picks 5173/5174/…), so
# this is optional there. Set it in production to the admin panel origin(s), e.g.:
# CORS_ORIGINS=https://admin.masafashion.com,https://masafashion.com

# PostgreSQL (local dev via WSL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/masa

# --- LLM provider: OpenRouter (sales agent + vision both route here) ---
# Required. Mastra's model router reads this for any `openrouter/...` model id.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
# Sales-agent model (Mastra model-router string). Swap to tune without a redeploy,
# e.g. openrouter/google/gemini-2.5-flash or openrouter/google/gemini-3-flash-preview.
AGENT_MODEL_ID=openrouter/google/gemini-3.5-flash
# Vision (customer-image attribute extraction) model — multimodal, via OpenRouter.
VISION_MODEL_ID=openrouter/google/gemini-3.5-flash
# Legacy Anthropic-direct key — optional now (only if a *_MODEL_ID points at anthropic/…).
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# Mastra framework log level: debug|info|warn|error|silent (default info). Set to
# 'debug' to see Mastra's agent-step / tool traces. Per-turn tool-call summaries
# are logged by AgentService regardless. PinoLogger emits JSON — for readable dev
# output run the server piped through `bunx pino-pretty`.
MASTRA_LOG_LEVEL=info

# --- Sales-agent generation & token tuning (all optional; validated defaults) ---
# Forwarded to the model every turn. Override per-env without a code change.
# Sampling temperature [0..2]; lower = more focused/consistent replies.
# AGENT_TEMPERATURE=0.5
# Nucleus sampling [0..1]. Prefer tuning either temperature OR topP, not both.
# AGENT_TOP_P=0.8
# Max output tokens generated PER STEP (must hold the Arabic reply + any tool JSON).
# Raise to 1024 if `finishReason=length` shows up on real order-confirmation turns.
# AGENT_MAX_OUTPUT_TOKENS=768
# Ceiling on tool-calling round-trips per customer message (Mastra maxSteps; its
# own default is 5). A runaway-loop / cost guard, not a primary saver — an
# order-confirmation turn can legitimately need ~5 steps, so 6 leaves headroom.
# Lower it from the per-turn usage log only if turns are wasting steps.
# AGENT_MAX_STEPS=6
# Conversation history kept in every prompt window (Mastra lastMessages). Includes
# tool-call/result payloads re-sent each step, so it strongly affects per-call size.
# AGENT_LAST_MESSAGES=10
# Knowledge pre-fetch note caps (RAG injected into context each turn): max FAQ
# entries and max characters per entry.
# AGENT_KNOWLEDGE_MAX_ENTRIES=3
# AGENT_KNOWLEDGE_MAX_CHARS=500
# Knowledge pre-fetch gating: 'gated' (default) injects the FAQ note only on
# FAQ-looking turns (shipping/returns/payment/fabric/sizing/policy keywords) —
# other turns rely on the get_knowledge tool. 'always' = legacy inject-every-turn;
# 'off' = tool-only.
# KNOWLEDGE_PREFETCH_MODE=gated
# History token diet: which tools' OLD calls/results are stripped from recalled
# history each prompt ('fat' = big-payload read tools, 'all', 'off' = legacy),
# and a hard estimated-token budget for recalled history (0 disables).
# Working memory + the last-shown recap note preserve the durable facts.
# AGENT_HISTORY_TOOL_FILTER=fat
# AGENT_HISTORY_TOKEN_LIMIT=12000

# Storage — product image uploads (flydrive, isolated in src/core/storage).
# STORAGE_DRIVER: 'fs' (local disk, dev only) | 'r2' (Cloudflare R2, default).
STORAGE_DRIVER=r2

# --- fs driver (local development only) ---
# Directory the fs driver writes to (created on boot, gitignored).
UPLOAD_DIR=./uploads

# Max upload size per file, in bytes (5 MiB).
UPLOAD_MAX_BYTES=5242880

# --- Cloudflare R2 (required when STORAGE_DRIVER=r2) ---
# Account ID (visible in the R2 dashboard).
R2_ACCOUNT_ID=your-account-id
# R2 API token credentials (generate in R2 → Manage API tokens).
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# Bucket name (create in R2 dashboard).
R2_BUCKET=masa-images
# S3-compatible endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# NO bucket name in the path — R2 does not use path-style buckets.
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# Public URL for the bucket (enable "Public access" in R2 dashboard, or use a
# custom domain). getUrl(key) returns ${R2_PUBLIC_URL}/${key}.
R2_PUBLIC_URL=https://pub.your-r2-domain.com
# R2 does not use real AWS regions — 'auto' is always the correct value.
R2_REGION=auto

# Debounce: how long to buffer rapid messages before running the agent (ms).
# DEBOUNCE_WINDOW_MS=2000

# Debounce: hard max wait time regardless of new messages arriving (ms).
# Keep well below Meta's webhook 20-second timeout.
# DEBOUNCE_MAX_MS=8000

# --- Meta Messenger Platform (direct Graph API, v25.0) ---
# Verify token echoed during webhook setup (GET /webhook/messenger). You pick the
# value; set the SAME string in the Meta App dashboard. Required in production.
MESSENGER_VERIFY_TOKEN=
# App Secret (Meta App → Settings → Basic) — validates X-Hub-Signature-256 on
# every inbound POST. Required in production. Keep it secret.
MESSENGER_APP_SECRET=
# The Facebook Page id messages are sent from (POST /{PAGE_ID}/messages).
MESSENGER_PAGE_ID=
# Long-lived Page access token (Meta App → Messenger → Generate token).
MESSENGER_PAGE_ACCESS_TOKEN=
# Graph API version — the single pin for every Graph call. Bump here only.
# MESSENGER_GRAPH_VERSION=v25.0
# Optional: ads token to resolve ad_id → campaign/adset names for attribution.
# META_ADS_ACCESS_TOKEN=

# Human-like reply pacing: deliver the reply as several short bubbles (split on
# blank lines) with a typing pause between them. Set to 'false' for one message.
# MESSENGER_HUMAN_PACING_ENABLED=true
# MESSENGER_TYPING_MS_PER_CHAR=45
# MESSENGER_TYPING_MIN_MS=700
# MESSENGER_TYPING_MAX_MS=2500
# MESSENGER_MAX_BUBBLES=4

# Public base URL for this server. Used by the fs storage driver to build
# image URLs: ${PUBLIC_BASE_URL}/uploads/<filename>.
PUBLIC_BASE_URL=http://localhost:3000

# Auth (admin panel JWT) — generate the secret with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Admin self-registration gate. POST /auth/register is CLOSED unless this is
# exactly 'true'. Set it to 'true' to bootstrap the FIRST admin (there is no seed
# mechanism), then turn it back off. Anything else (incl. unset) → 403.
# ALLOW_REGISTRATION=true

# --- Visual search embeddings (gemini-embedding-2 via OpenRouter) ---
# Multimodal embedding model: images AND text map into ONE unified vector space,
# reached over OpenRouter's OpenAI-compatible /embeddings endpoint with the same
# OPENROUTER_API_KEY. Swapping the model is a config change + a FULL re-backfill
# (embedding spaces are incompatible across models).
EMBEDDING_MODEL_ID=google/gemini-embedding-2
# Must equal the pgvector column + HNSW index (1536; within pgvector's 2000 cap).
EMBEDDING_DIM=1536
# Embeddings endpoint (OpenAI-compatible). Override only to point at a proxy.
EMBEDDING_API_URL=https://openrouter.ai/api/v1/embeddings
# Per-request timeout (ms) and retries on transient failures (429/5xx/network).
EMBEDDING_TIMEOUT_MS=15000
EMBEDDING_MAX_RETRIES=2
# Query-time embedding cache (dedupes re-embedding the same image/text within the
# TTL — e.g. the prefetch + tool double-embed on image turns). 0 disables.
# EMBEDDING_CACHE_TTL_MS=900000
# EMBEDDING_CACHE_MAX=200
# Visual-search default result size, and the minimum cosine similarity [0..1] a
# match must clear to be surfaced (below it the agent gets an empty result).
SIMILARITY_TOP_K=6
SIMILARITY_MIN_SCORE=0.6

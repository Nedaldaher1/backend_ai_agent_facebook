# Copy to .env and fill in. Validated at boot by src/core/config/env.schema.ts.
NODE_ENV=development
PORT=3000

# CORS — browser origins allowed to call the API, comma-separated.
# Local dev auto-allows any http://localhost:<port> (Vite picks 5173/5174/…), so
# this is optional there. Set it in production to the admin panel origin(s), e.g.:
# CORS_ORIGINS=https://admin.masafashion.com,https://masafashion.com

# PostgreSQL (local dev via WSL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/masa

# Anthropic (Claude) — used by the Mastra agent
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Storage — product image uploads (flydrive, isolated in src/core/storage).
# STORAGE_DRIVER: 'fs' (local disk, dev only) | 'r2' (Cloudflare R2, default).
STORAGE_DRIVER=r2

# --- fs driver (local development only; not reachable by Facebook/ManyChat) ---
# Directory the fs driver writes to (created on boot, gitignored).
UPLOAD_DIR=./uploads

# Max upload size per file, in bytes (5 MiB).
UPLOAD_MAX_BYTES=5242880

# --- Cloudflare R2 (required when STORAGE_DRIVER=r2) ---
# Account ID (visible in the R2 dashboard).
R2_ACCOUNT_ID=your-account-id
# R2 API token credentials (generate in R2 → Manage API tokens).
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# Bucket name (create in R2 dashboard).
R2_BUCKET=masa-images
# S3-compatible endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# NO bucket name in the path — R2 does not use path-style buckets.
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# Public URL for the bucket (enable "Public access" in R2 dashboard, or use a
# custom domain). getUrl(key) returns ${R2_PUBLIC_URL}/${key}.
R2_PUBLIC_URL=https://pub.your-r2-domain.com
# R2 does not use real AWS regions — 'auto' is always the correct value.
R2_REGION=auto

# --- ManyChat integration ---
# API token for the ManyChat Send API (async reply path).
# Generate in ManyChat → Settings → API → Create API Key.
# Leave empty to disable outgoing Send API calls (local dev).
MANYCHAT_API_TOKEN=

# Send API endpoint (default is correct; change only if ManyChat updates it).
# MANYCHAT_SEND_URL=https://api.manychat.com/fb/sending/sendContent

# Set to 'false' to fully disable outgoing ManyChat Send API calls.
# MANYCHAT_ENABLED=true

# Shared secret sent by ManyChat in the x-manychat-secret header.
# Set in ManyChat → Flow → External Request → Custom Headers.
# If unset, the guard logs a warning and allows the request (dev-only behaviour).
# Required in production: openssl rand -hex 24
WEBHOOK_SHARED_SECRET=

# Debounce: how long to buffer rapid messages before running the agent (ms).
# DEBOUNCE_WINDOW_MS=2000

# Debounce: hard max wait time regardless of new messages arriving (ms).
# Must be well below ManyChat's 10-second External Request timeout.
# DEBOUNCE_MAX_MS=8000

# Public base URL for this server. Two uses:
#  1. fs storage driver builds image URLs as ${PUBLIC_BASE_URL}/uploads/<file>.
#  2. Dev tunnel: copy the cloudflared HTTPS URL here AND paste it into the
#     ManyChat External Request block URL field.
#     Run the tunnel: bun run tunnel  → copy the printed URL.
PUBLIC_BASE_URL=http://localhost:3000

# Auth (admin panel JWT) — generate the secret with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# --- Visual search embeddings (Marqo-FashionSigLIP via Transformers.js) ---
# Multimodal model; images AND text embed into the same 768-d space. Runs
# in-process (onnxruntime-node), no external API. Swapping the model is a config
# change + `pnpm embeddings:backfill`, never a code edit.
EMBEDDING_MODEL_ID=Marqo/marqo-fashionSigLIP
# Must equal the model output dim, the pgvector column, and the HNSW index (768).
EMBEDDING_DIM=768
# ONNX weight dtype: fp32 (best retrieval quality) | q8 (smaller/faster). The
# SAME dtype is used for catalog and query embeddings.
EMBEDDING_DTYPE=fp32
# Writable, persistent dir for downloaded model files (gitignored). Pre-warm on
# deploy so the first request isn't a multi-hundred-MB download.
TRANSFORMERS_CACHE_DIR=./.cache/transformers
# Visual-search default result size, and the minimum cosine similarity [0..1] a
# match must clear to be surfaced (below it the agent gets an empty result).
SIMILARITY_TOP_K=6
SIMILARITY_MIN_SCORE=0.6

# Copy to .env and fill in. Validated at boot by src/core/config/env.schema.ts.
NODE_ENV=development
PORT=3000

# PostgreSQL (local dev via WSL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/masa

# Anthropic (Claude) — used by the Mastra agent
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Auth (admin panel JWT) — generate the secret with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
